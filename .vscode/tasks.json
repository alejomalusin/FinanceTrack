{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FinanceTrack: Preparar SQL Server local (aceptar aviso de Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/database/setup-local.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "FinanceTrack: Backend",
      "type": "process",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "financetrack-backend",
        "pattern": [{ "regexp": ".*" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting FinanceTrackApplication",
          "endsPattern": "Started FinanceTrackApplication"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "FinanceTrack: Frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "financetrack-frontend",
        "pattern": [{ "regexp": ".*" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "http://localhost:5173/"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "FinanceTrack: Iniciar aplicación",
      "dependsOn": [
        "FinanceTrack: Backend",
        "FinanceTrack: Frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
